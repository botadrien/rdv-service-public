#!/usr/bin/env ruby
# Vérifie que le partage en shards des specs en CI (voir .github/workflows/ci.yml, job "tests")
# couvre bien tous les fichiers de specs, exactement une fois chacun : pas de fichier oublié
# (jamais exécuté par aucun shard) ni exécuté deux fois (par deux shards différents).
#
# N'a besoin ni de Rails ni d'une base de données : parallel_tests partitionne les fichiers via
# une simple recherche par pattern + regroupement (par taille de fichier ou temps d'exécution),
# ce qui est un calcul purement local, indépendant de l'exécution des specs elles-mêmes.
#
# Important : les patterns ci-dessous doivent rester synchronisés avec matrix.pattern dans
# .github/workflows/ci.yml (job "tests") et le pattern du job "test_features_autodoc".

require "parallel_tests"
require "parallel_tests/rspec/runner"

CATEGORIES = {
  "unit" => "spec/(?!features)",
  "feature_agents" => "spec/features/agents",
  "feature_rest" => "spec/features/(?!(agents|autodoc))",
}.freeze

AUTODOC_PATTERN = "spec/features/autodoc"

TOTAL_GROUPS = 8
FIRST_SHARD_GROUPS = (0..3)
SECOND_SHARD_GROUPS = (4..7)

errors = []
all_covered = []

CATEGORIES.each do |name, pattern_str|
  pattern = Regexp.new(pattern_str)
  groups = ParallelTests::RSpec::Runner.tests_in_groups(["spec"], TOTAL_GROUPS, pattern: pattern, group_by: :filesize)
  shard1 = groups[FIRST_SHARD_GROUPS].flatten
  shard2 = groups[SECOND_SHARD_GROUPS].flatten

  overlap = shard1 & shard2
  errors << "#{name}: #{overlap.size} fichier(s) présents dans les deux shards : #{overlap.inspect}" if overlap.any?

  combined = (shard1 + shard2).sort
  direct = ParallelTests::RSpec::Runner.send(:find_tests, ["spec"], pattern: pattern).sort

  missing = direct - combined
  errors << "#{name}: #{missing.size} fichier(s) non couverts par aucun shard : #{missing.inspect}" if missing.any?

  puts "#{name}: #{combined.size} fichiers, #{shard1.size} dans le shard 1, #{shard2.size} dans le shard 2"
  all_covered.concat(combined)
end

autodoc_files = ParallelTests::RSpec::Runner.send(:find_tests, ["spec"], pattern: Regexp.new(AUTODOC_PATTERN))
puts "autodoc: #{autodoc_files.size} fichiers (job dédié, non shardé)"
all_covered.concat(autodoc_files)

full_spec_files = ParallelTests::RSpec::Runner.send(:find_tests, ["spec"], pattern: //)
missing_everywhere = full_spec_files - all_covered
duplicated = all_covered - full_spec_files

errors << "Fichiers non couverts par AUCUN job de CI : #{missing_everywhere.inspect}" if missing_everywhere.any?
errors << "Fichiers couverts par plusieurs catégories à la fois : #{duplicated.inspect}" if duplicated.any?

if errors.any?
  warn "\n== Échec de la vérification de couverture des specs en CI =="
  errors.each { |e| warn "- #{e}" }
  exit 1
end

puts "\nOK : les #{full_spec_files.size} fichiers de specs sont tous couverts, exactement une fois chacun."
